<% layout("/layouts/boilerplate") %>


<div class="row mt-3">
<h1 class="col-6 offset-3">SignUp to StayScape</h1>
    <div class="col-6 offset-3">
        <form action="/signup" METHOD="POST">
            <div >
            <label for="username" class="form-label" class="needs-validation" novalidate>Username</label>
            <input name="username" id="username" type="text" class="form-control" required/>
            <div class="valid-feedback">looks good!</div>
            </div>
            <br/><br/>
            <div >
            <label for="email" class="form-label" class="needs-validation" novalidate>Email</label>
            <input name="email" id="email" type="text" class="form-control" required/>
            <div class="valid-feedback">looks good!</div>
            </div>
            <br/><br/>
            <div >
            <label for="password" class="form-label" class="needs-validation" novalidate>Password</label>
            <input name="password" id="password" type="password" class="form-control" required/>
            <div class="valid-feedback">looks good!</div>
            </div>
            <br/><br/>
            <button class="btn btn-success">SignUp</button>
        </form>
    </div>
</div>